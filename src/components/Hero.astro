---
import { Picture } from 'astro:assets';
import outsideImage from '../assets/images/outside.png';
import { SITE, whatsappUrl, type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const wa = whatsappUrl(t.whatsapp.prefill);
---
<section class="hero" aria-label={t.hero.brand}>
  <div class="hero__media" aria-hidden="true">
    <Picture
      class="hero__picture"
      src={outsideImage}
      formats={['avif', 'webp']}
      widths={[1280, 1600, 1920, 2048]}
      sizes="100vw"
      quality={100}
      alt=""
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="hero__veil"></div>
  <div class="hero__content">
    <p class="hero__brand brand">{t.hero.brand}</p>
    <h1 class="hero__title">{t.hero.headline}</h1>
    <p class="hero__support">{t.hero.support}</p>
    <div class="hero__actions">
      <a class="btn btn-primary" href={`tel:${SITE.phoneTel}`}>{t.hero.ctaCall}</a>
      <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener noreferrer">{t.hero.ctaWhatsApp}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    min-height: 100svh;
    color: #fff;
    overflow: hidden;
  }

  .hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__media :global(picture),
  .hero__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero__media :global(img) {
    object-fit: cover;
    object-position: center 40%;
    animation: kenburns 22s ease-in-out alternate infinite;
  }

  .hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to top,
        rgba(14, 24, 18, 0.88) 0%,
        rgba(14, 24, 18, 0.42) 42%,
        rgba(14, 24, 18, 0.18) 100%
      );
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    padding: calc(var(--header-h) + 1.5rem) var(--space) 2.5rem;
  }

  .hero__brand {
    margin: 0 0 1.25rem;
    font-size: clamp(2.45rem, 12vw, 5.5rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: -0.03em;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.3);
  }

  .hero__title {
    font-family: var(--font-display);
    font-size: clamp(1.2rem, 2.8vw, 1.7rem);
    font-weight: 500;
    font-style: italic;
    margin: 0 0 0.85rem;
    line-height: 1.35;
    max-width: 28ch;
    opacity: 0.95;
  }

  .hero__support {
    font-size: clamp(1rem, 2vw, 1.125rem);
    max-width: 34ch;
    margin: 0 0 2rem;
    line-height: 1.55;
    opacity: 0.88;
    font-weight: 400;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__content > * {
    animation: heroRise 0.9s var(--ease-out) both;
  }

  .hero__content > *:nth-child(1) { animation-delay: 0.05s; }
  .hero__content > *:nth-child(2) { animation-delay: 0.2s; }
  .hero__content > *:nth-child(3) { animation-delay: 0.35s; }
  .hero__content > *:nth-child(4) { animation-delay: 0.48s; }

  @media (min-width: 800px) {
    .hero {
      flex-direction: row;
      align-items: flex-end;
    }

    .hero__veil {
      background:
        linear-gradient(
          to top,
          rgba(14, 24, 18, 0.9) 0%,
          rgba(14, 24, 18, 0.44) 38%,
          rgba(14, 24, 18, 0.08) 70%,
          rgba(14, 24, 18, 0.18) 100%
        ),
        linear-gradient(90deg, rgba(14, 24, 18, 0.58) 0%, rgba(14, 24, 18, 0.18) 48%, transparent 76%),
        radial-gradient(ellipse 80% 50% at 20% 100%, rgba(107, 58, 66, 0.22), transparent 60%);
    }

    .hero__content {
      width: min(42rem, 100%);
      margin-right: auto;
      margin-left: max(0px, calc((100vw - var(--max)) / 2));
      padding: calc(var(--header-h) + 2.5rem) var(--space) clamp(3.25rem, 11vh, 5.5rem);
    }

    .hero__media :global(img) {
      object-position: center 35%;
    }
  }

  @media (max-width: 520px) {
    .hero__actions .btn {
      flex: 1 1 calc(50% - 0.375rem);
      min-width: 0;
      padding: 0.8rem 0.9rem;
      font-size: 0.88rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__media :global(img) {
      animation: none;
    }
  }
</style>
