---
import FlagIcon from './FlagIcon.astro';
import {
  locales,
  localePath,
  switchLocalePath,
  SITE,
  whatsappUrl,
  type Dictionary,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { locale, t } = Astro.props;
const wa = whatsappUrl(t.whatsapp.prefill);
const year = new Date().getFullYear();
const home = localePath(locale);
const privacy = localePath(locale, 'privacy');
const pathname = Astro.url.pathname;
const { legal } = SITE;
const localeCodes = { it: 'IT', en: 'EN', fr: 'FR' } as const;
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <a class="site-footer__name brand" href={home}>{t.hero.brand}</a>
        <address class="site-footer__address">{SITE.address}</address>
        <p class="site-footer__legal">
          {legal.denominazione}
          <br />
          {t.footer.vat} {legal.partitaIva}
          <br />
          REA {legal.rea.provincia} {legal.rea.numero}
        </p>
      </div>

      <div class="site-footer__cols">
        <div class="site-footer__col">
          <p class="site-footer__label">{t.info.phoneLabel}</p>
          <a href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
          <a href={wa} target="_blank" rel="noopener noreferrer">{t.nav.whatsapp}</a>
        </div>

        <div class="site-footer__col">
          <p class="site-footer__label">{t.footer.follow}</p>
          <a href={SITE.instagram} target="_blank" rel="noopener noreferrer">Instagram</a>
          {SITE.facebook && (
            <a href={SITE.facebook} target="_blank" rel="noopener noreferrer">Facebook</a>
          )}
        </div>

        <nav class="site-footer__col" aria-label={t.a11y.languageNav}>
          <div class="site-footer__langs">
            {locales.map((l) => (
              <a
                href={switchLocalePath(pathname, l)}
                hreflang={l}
                aria-current={l === locale ? 'page' : undefined}
              >
                <FlagIcon locale={l} />
                <span>{localeCodes[l]}</span>
              </a>
            ))}
          </div>
          <a href={privacy}>{t.footer.privacy}</a>
        </nav>
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>&copy; {year} {t.footer.rights}</p>
      <p>
        {t.footer.credit}{' '}
        <a href={SITE.creditUrl} target="_blank" rel="noopener noreferrer">
          {t.footer.creditLinkLabel}
        </a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #101a14;
    color: rgba(255, 255, 255, 0.78);
    padding: clamp(2.5rem, 5vw, 3.5rem) var(--space) 2rem;
    margin: 0;
  }

  .site-footer__inner {
    max-width: var(--max);
    margin: 0 auto;
  }

  .site-footer__top {
    display: grid;
    gap: 2rem;
    padding-bottom: 1.75rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  @media (min-width: 760px) {
    .site-footer__top {
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1.4fr);
      align-items: start;
      gap: 3rem;
    }
  }

  .site-footer__name {
    display: inline-block;
    margin: 0 0 0.65rem;
    color: #fff;
    text-decoration: none;
    font-size: clamp(1.5rem, 3vw, 1.85rem);
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .site-footer__address {
    margin: 0;
    font-style: normal;
    font-size: 0.95rem;
    line-height: 1.55;
    max-width: 22ch;
    color: rgba(255, 255, 255, 0.62);
  }

  .site-footer__legal {
    margin: 0.85rem 0 0;
    font-size: 0.78rem;
    line-height: 1.55;
    max-width: 36ch;
    color: rgba(255, 255, 255, 0.42);
  }

  .site-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1.25rem;
  }

  @media (min-width: 560px) {
    .site-footer__cols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .site-footer__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.4rem;
  }

  .site-footer__label {
    margin: 0 0 0.25rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.45);
  }

  .site-footer a {
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .site-footer a:hover {
    color: #fff;
  }

  .site-footer__langs {
    display: flex;
    gap: 0.65rem;
  }

  .site-footer__langs a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.06em;
  }

  .site-footer__langs a[aria-current='page'] {
    color: #fff;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-top: 1.25rem;
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.42);
  }

  .site-footer__bottom p {
    margin: 0;
  }

  .site-footer__bottom a {
    font-size: inherit;
    color: rgba(255, 255, 255, 0.62);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }

  .site-footer__bottom a:hover {
    color: #fff;
  }
</style>
