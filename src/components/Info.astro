---
import { SITE, type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---
<section id="info" class="section reveal" aria-labelledby="info-title">
  <div class="section__inner info">
    <header class="info__intro">
      <span class="section__eyebrow">{t.nav.info}</span>
      <h2 id="info-title" class="info__title">{t.info.title}</h2>
    </header>

    <div class="info__table-wrap">
      <table class="info__table">
        <tbody>
          <tr>
            <th scope="row">{t.info.hoursLabel}</th>
            <td>{t.info.hours}</td>
          </tr>
          <tr>
            <th scope="row">{t.info.bookingLabel}</th>
            <td>{t.info.booking}</td>
          </tr>
          <tr>
            <th scope="row">{t.info.coverLabel}</th>
            <td>{t.info.cover}</td>
          </tr>
          <tr>
            <th scope="row">{t.info.priceLabel}</th>
            <td>{t.info.price}</td>
          </tr>
          <tr>
            <th scope="row">{t.info.addressLabel}</th>
            <td>
              <address class="info__address">{SITE.address}</address>
              <a
                class="info__link"
                href={SITE.mapsUrl}
                target="_blank"
                rel="noopener noreferrer"
              >
                {t.info.mapCta}
              </a>
            </td>
          </tr>
          <tr>
            <th scope="row">{t.info.phoneLabel}</th>
            <td>
              <a class="info__link" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
            </td>
          </tr>
        </tbody>
      </table>
    </div>

    <div class="info__map-block">
      <h3 class="info__map-title">{t.info.mapTitle}</h3>
      <div class="info__map">
        <iframe
          title={t.info.mapTitle}
          src={SITE.mapsEmbedUrl}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </div>
</section>

<style>
  .info__intro {
    margin-bottom: clamp(1.75rem, 4vw, 2.5rem);
    max-width: 36rem;
  }

  .info__title {
    font-size: clamp(2rem, 4.5vw, 3.15rem);
    margin: 0;
    color: var(--color-ink);
  }

  .info__table-wrap {
    margin-bottom: clamp(2rem, 4vw, 2.75rem);
    overflow-x: auto;
  }

  .info__table {
    width: 100%;
    max-width: 40rem;
    border-collapse: collapse;
    table-layout: fixed;
  }

  .info__table th,
  .info__table td {
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--color-line);
    vertical-align: top;
    text-align: left;
    font-size: 1rem;
    line-height: 1.5;
  }

  .info__table tr:first-child th,
  .info__table tr:first-child td {
    border-top: 1px solid var(--color-line);
  }

  .info__table th {
    width: 10.5rem;
    padding-right: 1.25rem;
    font-weight: 600;
    font-size: 0.88rem;
    color: var(--color-leaf);
    white-space: nowrap;
  }

  .info__table td {
    color: var(--color-ink);
    white-space: pre-line;
  }

  .info__address {
    font-style: normal;
    margin: 0 0 0.3rem;
  }

  .info__link {
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--color-leaf) 40%, transparent);
    transition: border-color 0.2s ease, color 0.2s ease;
  }

  .info__link:hover {
    color: var(--color-ink);
    border-bottom-color: var(--color-ink);
  }

  .info__map-title {
    font-family: var(--font-display);
    font-size: 1.25rem;
    margin: 0 0 0.85rem;
    color: var(--color-ink);
  }

  .info__map {
    position: relative;
    width: 100%;
    aspect-ratio: 21 / 9;
    min-height: 12rem;
    overflow: hidden;
    border: 1px solid var(--color-line);
    background: var(--color-mist);
  }

  .info__map iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
    filter: grayscale(0.25) contrast(1.02);
  }

  @media (max-width: 520px) {
    .info__table th {
      width: 7.5rem;
      padding-right: 0.85rem;
      white-space: normal;
    }

    .info__map {
      aspect-ratio: 4 / 3;
    }
  }
</style>
