---
import { SITE, type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { t } = Astro.props;
---
<section class="section section--cream reveal" aria-labelledby="info-title">
  <div class="section__inner info">
    <h2 id="info-title" class="info__title">{t.info.title}</h2>
    <dl class="info__list">
      <div class="info__row">
        <dt>{t.info.hoursLabel}</dt>
        <dd>{t.info.hours}</dd>
      </div>
      <div class="info__row">
        <dt>{t.info.priceLabel}</dt>
        <dd>{t.info.price}</dd>
      </div>
      <div class="info__row">
        <dt>{t.info.addressLabel}</dt>
        <dd>
          <address class="info__address">{SITE.address}</address>
          <a
            class="info__link"
            href={SITE.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
          >
            {t.info.mapCta}
          </a>
        </dd>
      </div>
      <div class="info__row">
        <dt>{t.info.phoneLabel}</dt>
        <dd>
          <a class="info__link" href={`tel:${SITE.phoneTel}`}>{SITE.phoneDisplay}</a>
        </dd>
      </div>
    </dl>
  </div>
</section>

<style>
  .info__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 2rem;
    color: var(--color-ink);
  }

  .info__list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
    max-width: 36rem;
  }

  .info__row {
    display: grid;
    grid-template-columns: minmax(6rem, 8rem) 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(44, 58, 46, 0.12);
  }

  .info__row:first-of-type {
    border-top: 1px solid rgba(44, 58, 46, 0.12);
  }

  .info__row dt {
    font-weight: 600;
    font-size: 0.9rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-leaf);
    margin: 0;
  }

  .info__row dd {
    margin: 0;
    line-height: 1.55;
  }

  .info__address {
    font-style: normal;
    margin: 0 0 0.5rem;
  }

  .info__link {
    font-weight: 600;
  }

  @media (max-width: 480px) {
    .info__row {
      grid-template-columns: 1fr;
      gap: 0.35rem;
    }
  }
</style>
