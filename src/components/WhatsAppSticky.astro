---
import { whatsappUrl, type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
const wa = whatsappUrl(t.whatsapp.prefill);
---
<a
  class="wa-sticky"
  href={wa}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={t.a11y.stickyWhatsApp}
>
  WhatsApp
</a>

<style>
  .wa-sticky {
    position: fixed;
    bottom: 1.25rem;
    right: 1.25rem;
    z-index: 90;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.9rem 1.2rem;
    background: var(--color-wine);
    color: #fff;
    font: 600 0.88rem/1 var(--font-body);
    letter-spacing: 0.02em;
    text-decoration: none;
    border-radius: 3px;
    box-shadow: 0 8px 24px rgba(26, 42, 34, 0.28);
    transition: background 0.25s var(--ease-out), transform 0.25s var(--ease-out);
  }

  .wa-sticky:hover {
    background: var(--color-wine-deep);
    transform: translateY(-2px);
  }

  @media (min-width: 768px) {
    .wa-sticky {
      padding: 0.8rem 1.1rem;
      font-size: 0.85rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wa-sticky:hover {
      transform: none;
    }
  }
</style>
