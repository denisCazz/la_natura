---
import { menu } from '../data/menu';
import { type Dictionary, type Locale } from '../i18n';

interface Props {
  t: Dictionary;
  locale: Locale;
}

const { t, locale } = Astro.props;

const intlLocale = locale === 'en' ? 'en-GB' : locale === 'fr' ? 'fr-FR' : 'it-IT';
const formatPrice = (amount: number) =>
  new Intl.NumberFormat(intlLocale, { style: 'currency', currency: 'EUR' }).format(amount);

const categoryTitle = (id: string, fallback: string) => t.menu.categories[id] ?? fallback;
---

<section class="section menu-page" aria-label={t.menu.title}>
  <div class="section__inner menu">
    <div class="menu__catalog">
      {menu.categorie.map((category) => (
        <section class="menu__category" aria-labelledby={`menu-cat-${category.id}`}>
          <h2 id={`menu-cat-${category.id}`} class="menu__category-title">
            {categoryTitle(category.id, category.nome)}
          </h2>
          <ul class="menu__dishes">
            {category.prodotti.map((item) => {
              const meta = [
                item.formato,
                item.tipologie?.join(' / '),
                item.cantina,
              ].filter(Boolean);

              return (
                <li class="menu__dish">
                  <div class="menu__dish-main">
                    <span class="menu__dish-name">
                      {item.nome}
                      {item.surgelato ? <span class="menu__frozen" aria-hidden="true">*</span> : null}
                    </span>
                    <span class="menu__dish-price">{formatPrice(item.prezzo)}</span>
                  </div>
                  {item.descrizione ? <p class="menu__dish-desc">{item.descrizione}</p> : null}
                  {meta.length > 0 ? (
                    <p class="menu__dish-meta">{meta.join(' · ')}</p>
                  ) : null}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>

    <footer class="menu__footer">
      <ul class="menu__notes">
        {t.menu.notes.map((note) => (
          <li>{note}</li>
        ))}
      </ul>
      <p class="menu__note">{t.menu.coverNote}</p>
    </footer>
  </div>
</section>

<style>
  .menu-page {
    min-height: 70svh;
    padding-bottom: clamp(3rem, 8vw, 5rem);
  }

  .menu__catalog {
    display: grid;
    gap: clamp(2.25rem, 5vw, 3.25rem);
  }

  .menu__category-title {
    font-family: var(--font-display);
    font-size: clamp(1.35rem, 2.8vw, 1.75rem);
    margin: 0 0 1.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--color-line);
    color: var(--color-ink);
  }

  .menu__dishes {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 1rem;
  }

  .menu__dish-main {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.25rem;
  }

  .menu__dish-name {
    font-size: 1.05rem;
    line-height: 1.45;
    font-weight: 500;
  }

  .menu__frozen {
    color: var(--color-wine);
    font-weight: 700;
    margin-left: 0.15em;
  }

  .menu__dish-price {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 650;
    color: var(--color-wine);
    white-space: nowrap;
  }

  .menu__dish-desc,
  .menu__dish-meta {
    margin: 0.2rem 0 0;
    font-size: 0.92rem;
    line-height: 1.45;
    color: color-mix(in srgb, var(--color-ink) 72%, transparent);
  }

  .menu__dish-meta {
    font-style: italic;
  }

  .menu__footer {
    margin-top: clamp(2.5rem, 6vw, 3.5rem);
    padding-top: 1.75rem;
    border-top: 1px dashed var(--color-line);
    max-width: 36rem;
  }

  .menu__note {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-ink);
    font-weight: 600;
  }

  .menu__notes {
    margin: 0 0 1rem;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.35rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-leaf);
  }

  @media (min-width: 720px) {
    .menu__catalog {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: clamp(2rem, 5vw, 4rem);
      align-items: start;
    }
  }
</style>
