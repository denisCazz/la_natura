---
import { localePath, type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { locale, t } = Astro.props;
const privacyHref = localePath(locale, 'privacy');
---
<div
  class="cookie-consent"
  id="cookie-consent"
  role="dialog"
  aria-labelledby="cookie-consent-title"
  aria-describedby="cookie-consent-body"
  hidden
>
  <div class="cookie-consent__inner">
    <div class="cookie-consent__copy">
      <p class="cookie-consent__title" id="cookie-consent-title">{t.cookies.title}</p>
      <p class="cookie-consent__body" id="cookie-consent-body">
        {t.cookies.body}
        {' '}
        <a href={privacyHref}>{t.cookies.policyLink}</a>
      </p>
    </div>
    <button type="button" class="cookie-consent__accept" id="cookie-consent-accept">
      {t.cookies.accept}
    </button>
  </div>
</div>

<style>
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 120;
    padding: 0.85rem var(--space) calc(0.85rem + env(safe-area-inset-bottom, 0px));
    background: rgba(16, 26, 20, 0.96);
    color: rgba(255, 255, 255, 0.88);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 -12px 32px rgba(16, 26, 20, 0.28);
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent__inner {
    max-width: var(--max);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.85rem 1.25rem;
  }

  .cookie-consent__copy {
    flex: 1 1 16rem;
    min-width: 0;
  }

  .cookie-consent__title {
    margin: 0 0 0.3rem;
    font: 650 0.72rem/1.2 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.5);
  }

  .cookie-consent__body {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
    max-width: 52rem;
  }

  .cookie-consent__body a {
    color: #fff;
    text-underline-offset: 0.15em;
  }

  .cookie-consent__accept {
    flex: 0 0 auto;
    appearance: none;
    border: 0;
    cursor: pointer;
    padding: 0.75rem 1.2rem;
    background: var(--color-leaf);
    color: #fff;
    font: 600 0.88rem/1 var(--font-body);
    letter-spacing: 0.02em;
    border-radius: 3px;
    transition: background 0.2s ease, transform 0.2s ease;
  }

  .cookie-consent__accept:hover {
    background: #354f40;
  }

  .cookie-consent__accept:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
</style>

<script>
  const KEY = 'la-natura-cookie-consent';
  const banner = document.getElementById('cookie-consent');
  const accept = document.getElementById('cookie-consent-accept');

  if (banner && accept) {
    try {
      if (!localStorage.getItem(KEY)) {
        banner.hidden = false;
        document.body.classList.add('cookie-banner-visible');
      }
    } catch {
      banner.hidden = false;
      document.body.classList.add('cookie-banner-visible');
    }

    accept.addEventListener('click', () => {
      try {
        localStorage.setItem(KEY, 'accepted');
      } catch {
        /* ignore quota / private mode */
      }
      banner.hidden = true;
      document.body.classList.remove('cookie-banner-visible');
    });
  }
</script>
