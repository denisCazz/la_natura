---
import { localePath, type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}

const { locale, t } = Astro.props;
const home = localePath(locale);
const menu = localePath(locale, 'menu');
---
<section class="not-found" aria-labelledby="not-found-title">
  <div class="not-found__inner">
    <p class="section__eyebrow not-found__eyebrow">{t.notFound.eyebrow}</p>
    <p class="not-found__brand brand">{t.hero.brand}</p>
    <h1 id="not-found-title" class="not-found__title">{t.notFound.title}</h1>
    <p class="not-found__body">{t.notFound.body}</p>
    <div class="not-found__actions">
      <a class="btn btn-primary" href={home}>{t.notFound.ctaHome}</a>
      <a class="btn not-found__ghost" href={menu}>{t.notFound.ctaMenu}</a>
    </div>
  </div>
</section>

<style>
  .not-found {
    flex: 1;
    display: grid;
    place-items: center;
    min-height: calc(100dvh - var(--header-h) - 8rem);
    padding: clamp(4rem, 12vw, 8rem) var(--space);
    background:
      radial-gradient(ellipse 90% 70% at 80% 0%, rgba(63, 94, 76, 0.12), transparent 55%),
      radial-gradient(ellipse 70% 50% at 10% 100%, rgba(107, 58, 66, 0.08), transparent 50%),
      linear-gradient(180deg, rgba(232, 239, 233, 0.65), transparent 45%);
  }

  .not-found__inner {
    max-width: 34rem;
    text-align: center;
  }

  .not-found__eyebrow {
    animation: not-found-in 0.7s var(--ease-out) both;
  }

  .not-found__brand {
    margin: 0 0 0.85rem;
    font-size: clamp(2.4rem, 7vw, 3.6rem);
    color: var(--color-leaf);
    animation: not-found-in 0.8s var(--ease-out) 0.08s both;
  }

  .not-found__title {
    margin: 0 0 1rem;
    font-size: clamp(1.55rem, 4vw, 2.15rem);
    color: var(--color-ink);
    animation: not-found-in 0.8s var(--ease-out) 0.16s both;
  }

  .not-found__body {
    margin: 0 auto 1.85rem;
    max-width: 28rem;
    color: var(--color-stone);
    font-size: 1.05rem;
    animation: not-found-in 0.8s var(--ease-out) 0.24s both;
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    animation: not-found-in 0.8s var(--ease-out) 0.32s both;
  }

  .not-found__ghost {
    background: transparent;
    color: var(--color-ink);
    border-color: rgba(26, 42, 34, 0.22);
  }

  .not-found__ghost:hover {
    background: rgba(63, 94, 76, 0.08);
    border-color: var(--color-leaf);
    color: var(--color-leaf);
  }

  @keyframes not-found-in {
    from {
      opacity: 0;
      transform: translateY(0.85rem);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .not-found__eyebrow,
    .not-found__brand,
    .not-found__title,
    .not-found__body,
    .not-found__actions {
      animation: none;
    }
  }
</style>
