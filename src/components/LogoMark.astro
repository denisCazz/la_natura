---
import { Image } from 'astro:assets';
import logoImage from '../assets/images/logo.png';

interface Props {
  class?: string;
  size?: 'sm' | 'md' | 'lg';
  alt?: string;
}

const { class: className = '', size = 'sm', alt = 'Agriturismo La Natura' } = Astro.props;
---
<span class:list={['logo-mark', `logo-mark--${size}`, className]}>
  <Image
    class="logo-mark__img"
    src={logoImage}
    widths={[42, 56, 144, 288]}
    sizes={size === 'lg' ? '(max-width: 400px) 38vw, 9rem' : size === 'md' ? '3.5rem' : '2.6rem'}
    quality={100}
    alt={alt}
    loading="eager"
    decoding="async"
  />
</span>

<style>
  .logo-mark {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    overflow: hidden;
    background: #fff;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.35), 0 4px 16px rgba(14, 24, 18, 0.22);
  }

  .logo-mark--sm {
    width: 2.6rem;
    height: 2.6rem;
  }

  .logo-mark--md {
    width: 3.5rem;
    height: 3.5rem;
  }

  .logo-mark--lg {
    width: min(9rem, 36vw);
    height: min(9rem, 36vw);
    box-shadow: 0 2px 0 rgba(255, 255, 255, 0.2), 0 10px 32px rgba(14, 24, 18, 0.35);
  }

  .logo-mark :global(.logo-mark__img) {
    width: 100% !important;
    height: 100% !important;
    max-width: none !important;
    object-fit: cover;
    object-position: center;
    border-radius: 50%;
    display: block;
  }

  @media (max-width: 640px) {
    .logo-mark--sm {
      width: 2.4rem;
      height: 2.4rem;
    }
  }

  @media (max-width: 400px) {
    .logo-mark--lg {
      width: min(8.5rem, 38vw);
      height: min(8.5rem, 38vw);
    }
  }
</style>
