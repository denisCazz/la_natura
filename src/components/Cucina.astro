---
import { type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---
<section class="section reveal" id="cucina" aria-labelledby="cucina-title">
  <div class="section__inner cucina">
    <div class="cucina__text">
      <span class="section__eyebrow">{t.nav.cucina}</span>
      <h2 id="cucina-title" class="cucina__title">{t.cucina.title}</h2>
      <p class="cucina__body">{t.cucina.body}</p>
    </div>
    <figure class="cucina__media">
      <img
        src="/images/cucina.jpg"
        alt={t.cucina.imageAlt}
        loading="lazy"
        width="800"
        height="600"
      />
    </figure>
  </div>
</section>

<style>
  .cucina {
    display: grid;
    gap: clamp(2.25rem, 6vw, 4.5rem);
    align-items: center;
  }

  @media (min-width: 800px) {
    .cucina {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: clamp(3rem, 6vw, 5rem);
    }

    .cucina__text {
      padding-right: 1rem;
    }
  }

  .cucina__title {
    font-size: clamp(2rem, 4.5vw, 3.15rem);
    margin: 0 0 1.15rem;
    color: var(--color-ink);
  }

  .cucina__body {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
    max-width: 38ch;
    color: color-mix(in srgb, var(--color-ink) 88%, transparent);
  }

  .cucina__media {
    margin: 0;
    position: relative;
  }

  .cucina__media::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1rem -1rem 1.25rem;
    background: var(--color-mist);
    z-index: -1;
  }

  .cucina__media img {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  @media (max-width: 799px) {
    .cucina__media::before {
      display: none;
    }

    .cucina__media img {
      aspect-ratio: 4 / 3;
    }
  }
</style>
