---
import { type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { t } = Astro.props;
---
<section class="section reveal" aria-labelledby="cucina-title">
  <div class="section__inner cucina">
    <div class="cucina__text">
      <h2 id="cucina-title" class="cucina__title">{t.cucina.title}</h2>
      <p class="cucina__body">{t.cucina.body}</p>
    </div>
    <figure class="cucina__media">
      <img
        src="/images/cucina.jpg"
        alt={t.cucina.imageAlt}
        loading="lazy"
        width="800"
        height="600"
      />
    </figure>
  </div>
</section>

<style>
  .cucina {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .cucina {
      grid-template-columns: 1fr 1fr;
    }
  }

  .cucina__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    color: var(--color-ink);
  }

  .cucina__body {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.65;
    max-width: 42ch;
  }

  .cucina__media {
    margin: 0;
  }

  .cucina__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }
</style>
