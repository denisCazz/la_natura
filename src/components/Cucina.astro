---
import { Picture } from 'astro:assets';
import cucinaImage from '../assets/images/cucina.jpg';
import { type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---
<section class="section reveal" id="cucina" aria-labelledby="cucina-title">
  <div class="section__inner cucina">
    <div class="cucina__text">
      <span class="section__eyebrow">{t.nav.cucina}</span>
      <h2 id="cucina-title" class="cucina__title">{t.cucina.title}</h2>
      <p class="cucina__body">{t.cucina.body}</p>
    </div>
    <figure class="cucina__media">
      <Picture
        src={cucinaImage}
        formats={['avif', 'webp']}
        widths={[960, 1200, 1600]}
        sizes="(min-width: 800px) 50vw, 100vw"
        quality={100}
        alt={t.cucina.imageAlt}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .cucina {
    display: grid;
    gap: var(--section-gap);
    align-items: center;
  }

  @media (min-width: 800px) {
    .cucina {
      grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
      gap: var(--section-gap);
    }

    .cucina__text {
      padding-right: 1rem;
    }
  }

  .cucina__title {
    font-size: clamp(2rem, 4.5vw, 3.15rem);
    margin: 0 0 1.15rem;
    color: var(--color-ink);
  }

  .cucina__body {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
    max-width: var(--content-measure);
    color: color-mix(in srgb, var(--color-ink) 88%, transparent);
  }

  .cucina__media {
    margin: 0;
    position: relative;
    overflow: hidden;
  }

  .cucina__media::before {
    content: '';
    position: absolute;
    inset: 1.25rem -1rem -1rem 1.25rem;
    background: var(--color-mist);
    z-index: -1;
  }

  .cucina__media :global(picture) {
    display: block;
    width: 100%;
  }

  .cucina__media :global(img) {
    display: block;
    width: 100%;
    height: auto;
    max-width: 100%;
    /* cucina.jpg = 1600×1067 */
    aspect-ratio: 1600 / 1067;
    object-fit: cover;
    object-position: center;
  }

  @media (max-width: 799px) {
    .cucina__media::before {
      display: none;
    }
  }
</style>
