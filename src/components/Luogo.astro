---
import { Picture } from 'astro:assets';
import outsideImage from '../assets/images/outside.png';
import { type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---
<section class="section section--mist reveal" id="luogo" aria-labelledby="luogo-title">
  <div class="section__inner luogo">
    <div class="luogo__text">
      <span class="section__eyebrow">{t.nav.luogo}</span>
      <h2 id="luogo-title" class="luogo__title">{t.luogo.title}</h2>
      <p class="luogo__body">{t.luogo.body}</p>
    </div>
    <figure class="luogo__media">
      <Picture
        src={outsideImage}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1200]}
        sizes="(min-width: 800px) 50vw, 100vw"
        alt={t.luogo.imageAlt}
        loading="lazy"
        decoding="async"
      />
    </figure>
  </div>
</section>

<style>
  .luogo {
    display: grid;
    gap: var(--section-gap);
    align-items: center;
  }

  @media (min-width: 800px) {
    .luogo {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.95fr);
      gap: var(--section-gap);
    }

    .luogo__text {
      grid-column: 2;
      padding-left: 0.5rem;
    }

    .luogo__media {
      grid-column: 1;
      grid-row: 1;
    }
  }

  .luogo__title {
    font-size: clamp(2rem, 4.5vw, 3.15rem);
    margin: 0 0 1.15rem;
    color: var(--color-ink);
  }

  .luogo__body {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
    max-width: var(--content-measure);
    color: color-mix(in srgb, var(--color-ink) 88%, transparent);
  }

  .luogo__media {
    margin: 0;
    position: relative;
  }

  .luogo__media::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 35%;
    background: linear-gradient(to top, rgba(26, 42, 34, 0.18), transparent);
    pointer-events: none;
  }

  .luogo__media :global(img) {
    width: 100%;
    aspect-ratio: 5 / 4;
    object-fit: cover;
  }

  @media (max-width: 799px) {
    .luogo__text {
      grid-row: 2;
    }

    .luogo__media {
      grid-row: 1;
    }
  }
</style>
