---
import { Picture } from 'astro:assets';
import outsideImage from '../assets/images/outside.png';
import { type Dictionary } from '../i18n';

interface Props {
  t: Dictionary;
}
const { t } = Astro.props;
---
<section class="luogo reveal" id="luogo" aria-labelledby="luogo-title">
  <div class="luogo__media" aria-hidden="true">
    <Picture
      src={outsideImage}
      formats={['avif', 'webp']}
      widths={[960, 1280, 1600, 2048]}
      sizes="100vw"
      quality={100}
      alt=""
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="luogo__veil"></div>
  <div class="luogo__content">
    <span class="luogo__eyebrow">{t.nav.luogo}</span>
    <h2 id="luogo-title" class="luogo__title">{t.luogo.title}</h2>
    <p class="luogo__body">{t.luogo.body}</p>
  </div>
</section>

<style>
  .luogo {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    min-height: clamp(28rem, 72vw, 38rem);
    overflow: hidden;
    color: #fff;
  }

  .luogo__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .luogo__media :global(picture),
  .luogo__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .luogo__media :global(img) {
    object-fit: cover;
    object-position: center;
  }

  .luogo__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to top,
        rgba(14, 24, 18, 0.94) 0%,
        rgba(14, 24, 18, 0.72) 42%,
        rgba(14, 24, 18, 0.35) 72%,
        rgba(14, 24, 18, 0.28) 100%
      ),
      linear-gradient(
        90deg,
        rgba(14, 24, 18, 0.55) 0%,
        rgba(14, 24, 18, 0.2) 55%,
        transparent 100%
      );
  }

  .luogo__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--max);
    margin: 0 auto;
    padding: clamp(3.5rem, 10vw, 5.5rem) var(--space);
  }

  .luogo__eyebrow {
    display: block;
    margin: 0 0 0.85rem;
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(232, 239, 233, 0.85);
  }

  .luogo__title {
    font-size: clamp(2rem, 4.5vw, 3.15rem);
    margin: 0 0 1.15rem;
    color: #fff;
    text-shadow: 0 2px 24px rgba(0, 0, 0, 0.35);
  }

  .luogo__body {
    margin: 0;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.7;
    max-width: 38ch;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 16px rgba(0, 0, 0, 0.35);
  }

  @media (max-width: 799px) {
    .luogo {
      min-height: clamp(26rem, 118vw, 34rem);
      /* outside.png = 2048×768 — keep panoramic crop readable */
      aspect-ratio: auto;
    }

    .luogo__media :global(img) {
      object-position: center 45%;
    }

    .luogo__veil {
      background:
        linear-gradient(
          to top,
          rgba(14, 24, 18, 0.96) 0%,
          rgba(14, 24, 18, 0.82) 48%,
          rgba(14, 24, 18, 0.45) 78%,
          rgba(14, 24, 18, 0.32) 100%
        );
    }

    .luogo__content {
      padding-top: clamp(4rem, 18vw, 6rem);
      padding-bottom: clamp(2.5rem, 8vw, 3.5rem);
    }

    .luogo__body {
      max-width: 34ch;
    }
  }
</style>
