---
import { type Dictionary, type Locale } from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { t } = Astro.props;
---
<section class="section reveal" aria-labelledby="luogo-title">
  <div class="section__inner luogo">
    <figure class="luogo__media">
      <img
        src="/images/luogo.jpg"
        alt={t.luogo.imageAlt}
        loading="lazy"
        width="800"
        height="600"
      />
    </figure>
    <div class="luogo__text">
      <h2 id="luogo-title" class="luogo__title">{t.luogo.title}</h2>
      <p class="luogo__body">{t.luogo.body}</p>
    </div>
  </div>
</section>

<style>
  .luogo {
    display: grid;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .luogo {
      grid-template-columns: 1fr 1fr;
    }
  }

  .luogo__title {
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    margin: 0 0 1rem;
    color: var(--color-ink);
  }

  .luogo__body {
    margin: 0;
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.65;
    max-width: 42ch;
  }

  .luogo__media {
    margin: 0;
  }

  .luogo__media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: 2px;
  }
</style>
