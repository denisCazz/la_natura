---
import LogoMark from './LogoMark.astro';
import FlagIcon from './FlagIcon.astro';
import {
  locales,
  localePath,
  switchLocalePath,
  SITE,
  whatsappUrl,
  type Dictionary,
  type Locale,
} from '../i18n';

interface Props {
  locale: Locale;
  t: Dictionary;
}
const { locale, t } = Astro.props;
const wa = whatsappUrl(t.whatsapp.prefill);
const home = localePath(locale);
const menuHref = localePath(locale, 'menu');
const pathname = Astro.url.pathname;
const isMenuPage = pathname.includes('/menu');
const localeOptions = {
  it: { code: 'IT', name: 'Italiano' },
  en: { code: 'EN', name: 'English' },
  fr: { code: 'FR', name: 'Français' },
} as const;

const links = [
  { href: home, label: t.nav.home, current: !isMenuPage },
  { href: menuHref, label: t.nav.menu, current: isMenuPage },
  { href: `${home}#cucina`, label: t.nav.cucina, current: false },
  { href: `${home}#luogo`, label: t.nav.luogo, current: false },
  { href: `${home}#info`, label: t.nav.info, current: false },
];

const localePaths = Object.fromEntries(
  locales.map((l) => [l, switchLocalePath(pathname, l)]),
) as Record<Locale, string>;
---
<header class:list={['nav', { 'is-solid': isMenuPage }]} data-header>
  <div class="nav__bar">
    <a class="nav__brand" href={home} aria-label={SITE.name}>
      <LogoMark size="sm" alt="" />
      <span class="nav__brand-text brand">{t.hero.brand}</span>
    </a>

    <nav class="nav__links" aria-label={t.a11y.mainNav}>
      {links.map((link) => (
        <a href={link.href} aria-current={link.current ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>

    <div class="nav__end">
      <a class="nav__cta" href={`tel:${SITE.phoneTel}`} aria-label={t.nav.call}>
        <span aria-hidden="true">☎</span>
        <span class="nav__cta-label">{t.nav.call}</span>
      </a>
      <div class="nav__lang" data-lang>
        <button
          class="nav__lang-trigger"
          type="button"
          id="nav-lang-trigger"
          aria-expanded="false"
          aria-haspopup="listbox"
          aria-controls="nav-lang-list"
          aria-label={t.a11y.languageNav}
          data-lang-trigger
        >
          <FlagIcon locale={locale} />
          <span class="nav__lang-code">{localeOptions[locale].code}</span>
          <span class="nav__lang-chevron" aria-hidden="true"></span>
        </button>
        <ul
          class="nav__lang-list"
          id="nav-lang-list"
          role="listbox"
          aria-labelledby="nav-lang-trigger"
          hidden
          data-lang-list
        >
          {locales.map((l) => (
            <li role="none">
              <a
                class="nav__lang-option"
                role="option"
                href={localePaths[l]}
                hreflang={l}
                lang={l}
                aria-selected={l === locale ? 'true' : 'false'}
                aria-current={l === locale ? 'page' : undefined}
                tabindex={l === locale ? 0 : -1}
              >
                <FlagIcon locale={l} />
                <span class="nav__lang-meta">
                  <span class="nav__lang-code">{localeOptions[l].code}</span>
                  <span class="nav__lang-name">{localeOptions[l].name}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <button
        class="nav__toggle"
        type="button"
        aria-expanded="false"
        aria-controls="nav-panel"
        aria-label={t.a11y.openMenu}
        data-burger
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div class="nav__panel" id="nav-panel" data-drawer hidden>
    <nav class="nav__panel-links" aria-label={t.a11y.mainNav}>
      {links.map((link) => (
        <a href={link.href} aria-current={link.current ? 'page' : undefined}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="nav__panel-meta">
      <div class="nav__panel-actions">
        <a class="btn btn-primary" href={`tel:${SITE.phoneTel}`}>{t.nav.call}</a>
        <a class="btn btn-ghost" href={wa} target="_blank" rel="noopener noreferrer">{t.nav.whatsapp}</a>
      </div>
    </div>
  </div>
</header>

<script
  define:vars={{
    openLabel: t.a11y.openMenu,
    closeLabel: t.a11y.closeMenu,
  }}
>
  const burger = document.querySelector('[data-burger]');
  const drawer = document.querySelector('[data-drawer]');
  const header = document.querySelector('[data-header]');
  const langRoot = document.querySelector('[data-lang]');
  const langTrigger = document.querySelector('[data-lang-trigger]');
  const langList = document.querySelector('[data-lang-list]');

  if (header instanceof HTMLElement) {
    const onScroll = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 16);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const setLangOpen = (open) => {
    if (!(langTrigger instanceof HTMLButtonElement) || !(langList instanceof HTMLElement)) return;
    langTrigger.setAttribute('aria-expanded', String(open));
    langList.hidden = !open;
    langRoot?.classList.toggle('is-open', open);
  };

  if (langTrigger instanceof HTMLButtonElement && langList instanceof HTMLElement) {
    langTrigger.addEventListener('click', (event) => {
      event.stopPropagation();
      setLangOpen(langTrigger.getAttribute('aria-expanded') !== 'true');
    });

    langList.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setLangOpen(false));
    });
  }

  if (burger instanceof HTMLButtonElement && drawer instanceof HTMLElement) {
    const setOpen = (open) => {
      burger.setAttribute('aria-expanded', String(open));
      burger.setAttribute('aria-label', open ? closeLabel : openLabel);
      burger.classList.toggle('is-open', open);
      drawer.hidden = !open;
      document.body.classList.toggle('nav-open', open);
      header?.classList.toggle('is-open', open);
      if (open) setLangOpen(false);
    };

    burger.addEventListener('click', () => {
      setOpen(burger.getAttribute('aria-expanded') !== 'true');
    });

    drawer.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      if (langTrigger?.getAttribute('aria-expanded') === 'true') {
        setLangOpen(false);
        langTrigger.focus();
        return;
      }
      if (burger.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        burger.focus();
      }
    });

    document.addEventListener('pointerdown', (event) => {
      if (!(event.target instanceof Node)) return;
      if (
        langTrigger?.getAttribute('aria-expanded') === 'true' &&
        langRoot &&
        !langRoot.contains(event.target)
      ) {
        setLangOpen(false);
      }
      if (
        burger.getAttribute('aria-expanded') === 'true' &&
        !header?.contains(event.target)
      ) {
        setOpen(false);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 900) setOpen(false);
    });
  }
</script>

<style>
  .nav {
    --nav-fg: #fff;
    --nav-muted: rgba(255, 255, 255, 0.72);
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    color: var(--nav-fg);
  }

  .nav::before {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(14, 24, 18, 0.82);
    backdrop-filter: blur(12px);
    opacity: 0;
    transition: opacity 0.3s var(--ease-out);
    pointer-events: none;
  }

  .nav.is-scrolled::before,
  .nav.is-solid::before,
  .nav.is-open::before {
    opacity: 1;
  }

  .nav__bar {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.75rem 1.25rem;
    max-width: var(--max);
    margin: 0 auto;
    padding: 0.65rem var(--space);
    min-height: var(--header-h);
  }

  .nav__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: inherit;
    text-decoration: none;
    line-height: 0;
    flex-shrink: 0;
    justify-self: start;
  }

  .nav__brand-text {
    font-size: 1.05rem;
    font-weight: 650;
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .nav__links {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.1rem;
  }

  .nav__links a {
    position: relative;
    color: var(--nav-muted);
    text-decoration: none;
    font-size: 0.88rem;
    font-weight: 500;
    padding: 0.4rem 0.7rem;
    transition: color 0.2s ease;
  }

  .nav__links a:hover,
  .nav__links a[aria-current='page'] {
    color: var(--nav-fg);
  }

  .nav__links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0.7rem;
    right: 0.7rem;
    bottom: 0.1rem;
    height: 1px;
    background: currentColor;
    opacity: 0.75;
  }

  .nav__end {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
    flex-shrink: 0;
    justify-self: end;
  }

  .nav__lang {
    position: relative;
    display: flex;
    align-items: center;
    flex-shrink: 0;
    z-index: 5;
  }

  .nav__lang-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    min-height: 2.35rem;
    padding: 0.35rem 0.7rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.08);
    color: var(--nav-fg);
    font: 600 0.78rem/1 var(--font-body);
    letter-spacing: 0.06em;
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav__lang-trigger:hover,
  .nav__lang.is-open .nav__lang-trigger,
  .nav__lang-trigger:focus-visible {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.08);
    outline: none;
  }

  .nav__lang-code {
    font-weight: 650;
  }

  .nav__lang-chevron {
    width: 0.4rem;
    height: 0.4rem;
    margin-left: 0.1rem;
    border-right: 1.5px solid currentColor;
    border-bottom: 1.5px solid currentColor;
    transform: rotate(45deg) translateY(-1px);
    opacity: 0.75;
    transition: transform 0.2s var(--ease-out);
  }

  .nav__lang.is-open .nav__lang-chevron {
    transform: rotate(225deg) translateY(-1px);
  }

  .nav__lang-list {
    position: absolute;
    top: calc(100% + 0.55rem);
    right: 0;
    z-index: 20;
    min-width: 11.5rem;
    margin: 0;
    padding: 0.4rem;
    list-style: none;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 14px;
    background: rgba(14, 24, 18, 0.96);
    backdrop-filter: blur(16px);
    box-shadow:
      0 18px 40px rgba(0, 0, 0, 0.35),
      inset 0 1px 0 rgba(255, 255, 255, 0.06);
    overflow-x: hidden;
    overflow-y: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
  }

  .nav__lang-list::-webkit-scrollbar {
    width: 0;
    height: 0;
    display: none;
  }

  .nav__lang-list[hidden] {
    display: none;
  }

  .nav__lang-option {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.65rem 0.75rem;
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.88);
    text-decoration: none;
    transition: background 0.18s ease, color 0.18s ease;
  }

  .nav__lang-option:hover,
  .nav__lang-option:focus-visible {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    outline: none;
  }

  .nav__lang-option[aria-current='page'],
  .nav__lang-option[aria-selected='true'] {
    background: rgba(232, 239, 233, 0.14);
    color: #fff;
  }

  .nav__lang-meta {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .nav__lang-name {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: rgba(255, 255, 255, 0.62);
  }

  .nav__lang-option .nav__lang-code {
    font-size: 0.82rem;
    letter-spacing: 0.08em;
  }

  .nav__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--nav-fg);
    text-decoration: none;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 0.5rem 0.95rem;
    border: 1px solid rgba(255, 255, 255, 0.4);
    border-radius: 2px;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .nav__cta:hover {
    background: rgba(255, 255, 255, 0.1);
    border-color: rgba(255, 255, 255, 0.85);
  }

  .nav__toggle {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 5px;
    width: 2.85rem;
    height: 2.85rem;
    margin: 0;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.16);
    color: inherit;
    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.06);
    cursor: pointer;
    transition:
      background 0.2s ease,
      border-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .nav__toggle:hover,
  .nav__toggle:focus-visible,
  .nav__toggle.is-open {
    background: rgba(255, 255, 255, 0.24);
    border-color: rgba(255, 255, 255, 0.9);
    box-shadow: 0 0 0 4px rgba(255, 255, 255, 0.1);
    outline: none;
  }

  .nav__toggle span {
    display: block;
    width: 1.15rem;
    height: 2px;
    margin: 0;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.25s var(--ease-out), opacity 0.2s ease;
  }

  .nav__toggle.is-open span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .nav__toggle.is-open span:nth-child(2) {
    opacity: 0;
  }

  .nav__toggle.is-open span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .nav__panel {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding: 0.5rem var(--space) 1.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(14, 24, 18, 0.96);
  }

  .nav__panel[hidden] {
    display: none;
  }

  .nav__panel-links {
    display: flex;
    flex-direction: column;
  }

  .nav__panel-links a {
    color: #fff;
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.65rem;
    font-weight: 500;
    padding: 0.7rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .nav__panel-links a[aria-current='page'] {
    color: var(--color-mist);
  }

  .nav__panel-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .nav__panel-actions .btn {
    flex: 1 1 8rem;
  }

  .nav__panel-actions .btn-ghost {
    border-color: rgba(255, 255, 255, 0.45);
  }

  @media (max-width: 420px) {
    .nav__brand-text {
      display: none;
    }
  }

  @media (max-width: 340px) {
    .nav__bar {
      gap: 0.35rem;
    }

    .nav__end {
      gap: 0.25rem;
    }

    .nav__cta {
      padding-inline: 0.6rem;
    }

    .nav__cta-label {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
    }

    .nav__lang-trigger {
      min-height: 2.15rem;
      padding-inline: 0.55rem 0.6rem;
    }

    .nav__lang-list {
      min-width: 10.5rem;
    }
  }

  @media (min-width: 900px) {
    .nav__bar {
      grid-template-columns: 1fr auto 1fr;
    }

    .nav__links {
      display: flex;
      grid-column: 2;
      grid-row: 1;
    }

    .nav__end {
      grid-column: 3;
    }

    .nav__toggle,
    .nav__panel {
      display: none !important;
    }
  }
</style>
